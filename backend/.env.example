# Database
DATABASE_URL=

# Frontend / backend URLs
FRONTEND_URL=https://boltiv.ng
FRONTEND_ORIGIN=https://boltiv.ng
BACKEND_PUBLIC_URL=https://boltiv-backend.onrender.com

# Authentication / admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=

# Flutterwave — BOLTIV payment provider
FLW_SECRET_KEY=
FLW_BASE_URL=https://api.flutterwave.com/v3
# Secret hash configured in Flutterwave Dashboard > Settings > Webhooks
FLW_SECRET_HASH=
# Optional transfer callback URL
FLW_CALLBACK_URL=

# SME API — single VTU provider for BOLTIV
SME_API_BASE_URL=https://smeapi.com.ng
SME_API_KEY=
# JSON maps matching SME API provider IDs. Confirm these IDs in your SME dashboard before live use.
SME_API_CABLE_PROVIDER_MAP={"DSTV":1,"GOTV":2,"STARTIMES":3}
SME_API_ELECTRICITY_PROVIDER_MAP={}
# Optional: map human-readable Cable plan names used by the current UI to SME API numeric plan IDs.
SME_API_CABLE_PLAN_MAP={"DSTV":{"Compact":1,"Confam":2,"Yanga":3},"GOTV":{"Jolli":4,"Max":5}}

# VTU reconciliation
PENDING_RECONCILE_INTERVAL_MS=300000

# Email / password reset
RESEND_API_KEY=
MAIL_FROM=BOLTIV <support@boltiv.ng>
