# Required
DATABASE_URL=
FRONTEND_URL=https://thatsdeeko.github.io/boltiv
FRONTEND_ORIGIN=https://thatsdeeko.github.io

# Authentication / admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Paystack
PAYSTACK_SECRET_KEY=

# Flutterwave payouts (admin-only profit withdrawals)
FLW_SECRET_KEY=
FLW_BASE_URL=https://api.flutterwave.com/v3
FLW_CALLBACK_URL=

# VTU provider
VTU_API_BASE_URL=https://api.vtugate.com
VTU_API_KEY=

# Email / password reset
RESEND_API_KEY=
MAIL_FROM=BOLTIV <onboarding@resend.dev>

# Render sets PORT automatically; do not hard-code it in production.

# VTU provider selection
# vtugate uses https://api.vtugate.com and application/x-www-form-urlencoded requests.
VTU_PROVIDER=vtugate
VTU_API_BASE_URL=https://api.vtugate.com
# Keep VTU_API_KEY secret; never expose it in frontend code.

# VTUGATE service IDs (get the IDs from your VTUGATE dashboard/API service list)
# Do not guess these values.
VTU_AIRTIME_SERVICE_ID=
VTU_DATA_SERVICE_ID=
VTU_CABLE_SERVICE_ID=
VTU_ELECTRICITY_SERVICE_ID=

# Bigisub provider (used by Betting, Bulk SMS and Recharge PIN services)
BIGISUB_API_BASE_URL=https://api.bigisub.ng
# Keep the permanent Bigisub API token secret; never expose it in frontend code.
BIGISUB_API_TOKEN=
BIGISUB_AUTH_SCHEME=Token
BIGISUB_BETTING_ENDPOINT=/api/v2/betting/fund
BIGISUB_SMS_ENDPOINT=/api/v2/sms/send
# Confirm the exact Recharge PIN purchase endpoint in your Bigisub docs/dashboard.
BIGISUB_RECHARGE_PIN_ENDPOINT=/api/v2/recharge-pin/purchase
