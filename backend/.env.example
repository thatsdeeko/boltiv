# BOLTIV — Railway production environment template
# Never commit real secret values.

# Railway PostgreSQL
DATABASE_URL=

# BOLTIV frontend
FRONTEND_URL=https://boltiv.ng
FRONTEND_ORIGIN=https://boltiv.ng

# Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=

# Flutterwave
FLW_SECRET_KEY=
FLW_BASE_URL=https://api.flutterwave.com/v3
FLW_SECRET_HASH=

# VTUGATE
VTUGATE_API_BASE_URL=https://api.vtugate.com
VTUGATE_API_KEY=
VTUGATE_SERVICE_MAP={}
VTUGATE_DATA_SERVICE_ID=

# Pending transaction reconciliation
PENDING_RECONCILE_INTERVAL_MS=300000

# Resend
RESEND_API_KEY=
MAIL_FROM=BOLTIV <support@boltiv.ng>

# Runtime
NODE_ENV=production
# PORT is supplied automatically by Railway. Do not hard-code it here.
