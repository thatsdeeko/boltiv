# Required
DATABASE_URL=
FRONTEND_URL=https://thatsdeeko.github.io/boltiv
FRONTEND_ORIGIN=https://thatsdeeko.github.io

# Authentication / admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Paystack
PAYSTACK_SECRET_KEY=

# Flutterwave payouts (admin-only profit withdrawals)
FLW_SECRET_KEY=
FLW_BASE_URL=https://api.flutterwave.com/v3
FLW_CALLBACK_URL=

# VTU providers
# CheapDataHub handles Airtime + Data in the current migration.
CHEAPDATAHUB_API_BASE_URL=https://www.cheapdatahub.ng/api/v1/resellers
CHEAPDATAHUB_API_KEY=

# VTUGATE remains available for Cable TV + Electricity until those services are migrated.
VTU_API_BASE_URL=https://api.vtugate.com
VTU_API_KEY=

# Email / password reset
RESEND_API_KEY=
MAIL_FROM=BOLTIV <onboarding@resend.dev>

# Render sets PORT automatically; do not hard-code it in production.

# VTU provider selection for services that have not yet moved to CheapDataHub.
# Airtime + Data automatically use CheapDataHub when CHEAPDATAHUB_API_KEY is configured.
VTU_PROVIDER=vtugate
VTU_API_BASE_URL=https://api.vtugate.com
# Keep VTU_API_KEY secret; never expose it in frontend code.

# VTUGATE service IDs (get the IDs from your VTUGATE dashboard/API service list)
# Do not guess these values.
VTU_AIRTIME_SERVICE_ID=
VTU_DATA_SERVICE_ID=
VTU_CABLE_SERVICE_ID=
VTU_ELECTRICITY_SERVICE_ID=

# Strowallet wallet funding (customer personal virtual accounts)
STROWALLET_PUBLIC_KEY=
# Alias also accepted: STROWALLET_API_KEY=
STROWALLET_BASE_URL=https://strowallet.com/api
STROWALLET_MODE=live
# Name shown as the sender on outgoing Strowallet bank transfers
STROWALLET_SENDER_NAME=BOLTIV TECHNOLOGIES LIMITED
# Default path creates Nombank MFB accounts. Alternatives:
# /virtual-bank/palmpay  /virtual-bank/paga  /virtual-bank/sterling  /virtual-bank/amucha  /virtual-bank/fidelitybank
STROWALLET_VA_PATH=/virtual-bank/new-customer
# Full public URL of this backend (used to build webhook URL if STROWALLET_WEBHOOK_URL is empty)
BACKEND_PUBLIC_URL=https://boltiv-backend.onrender.com
# Or set the webhook URL explicitly:
# STROWALLET_WEBHOOK_URL=https://boltiv-backend.onrender.com/api/strowallet/webhook

# Legacy Payscribe (optional — only still used for some admin payouts if configured)
PAYSCRIBE_API_KEY=
PAYSCRIBE_API_BASE_URL=https://api.payscribe.ng/api/v1
PAYSCRIBE_VA_CREATE_PATH=/collections/create
PAYSCRIBE_WEBHOOK_SECRET=
PAYSCRIBE_WEBHOOK_TOLERANCE_SECONDS=300
PAYSCRIBE_PAYOUT_COUNTRY=NGN
