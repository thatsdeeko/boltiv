# Database
DATABASE_URL=

# Frontend / backend URLs
FRONTEND_URL=https://boltiv.ng
FRONTEND_ORIGIN=https://boltiv.ng
BACKEND_PUBLIC_URL=https://boltiv-backend.onrender.com

# Authentication / admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=

# Flutterwave — BOLTIV payment provider
FLW_SECRET_KEY=
FLW_BASE_URL=https://api.flutterwave.com/v3
FLW_SECRET_HASH=
FLW_CALLBACK_URL=

# VTUGATE — LIVE production provider for BOLTIV
VTUGATE_API_BASE_URL=https://api.vtugate.com
VTUGATE_API_KEY=
# Optional JSON service-ID overrides. Normally BOLTIV resolves service IDs from VTUGATE fetchallservices.
VTUGATE_SERVICE_MAP={}
# Optional education product labels; VTUGATE service IDs are resolved from fetchallservices.
VTUGATE_EDUCATION_PRODUCTS={"waec":"WAEC","neco":"NECO","jamb":"JAMB","nabteb":"NABTEB"}

# VTUGATE reconciliation
PENDING_RECONCILE_INTERVAL_MS=300000

# Email / password reset
RESEND_API_KEY=
MAIL_FROM=BOLTIV <support@boltiv.ng>
